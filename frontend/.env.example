# 영상 정보 조회 엔드포인트. 없으면 배포된 Cloud Function을 사용한다.
# {videoId} 자리표시자를 쓰면 경로에 아이디를 넣는 서버도 사용할 수 있다.
# 예: http://localhost:8000/api/v1/youtube-video/info/{videoId}
VITE_VIDEO_INFO_URL=

# 영상 다운로드 백엔드(backend/ FastAPI) 주소.
# 비워두면 다운로드 API와 진행률 WebSocket을 사용하지 않는다.
# 로컬에서 backend를 띄웠다면: http://localhost:8000
VITE_DOWNLOAD_API_BASE_URL=

# development로 두면 Firebase 에뮬레이터와 로컬 백엔드를 기본값으로 쓴다.
VITE_APP_ENVIRONMENT=

# "true"로 두면 YouTube 도구(다운로더/태그 탐색기)를 노출한다.
# 현재 정보 API가 봇 판정으로 막혀 있어 기본은 숨김.
VITE_ENABLE_YOUTUBE_TOOL=
